# Copy to .env (gitignored) and fill in. Never commit real keys, never paste them into chat.

# Which model backend decides each step:
#   claude-code (default): your logged-in Claude Code CLI, billed to your Claude subscription.
#                          No API key is needed or used. Run `claude auth login` once.
#   api:                   the Anthropic API; requires ANTHROPIC_API_KEY below.
# CORBITS_MODEL_PROVIDER=claude-code
# CORBITS_CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=
# Model IDs are configuration, not code. claude-sonnet-5-5 is the cost-conscious default;
# see https://platform.claude.com/docs/en/about-claude/models/overview
CORBITS_CLAUDE_MODEL=claude-sonnet-5-5
DATABASE_URL=postgres://corbits:corbits_dev_only@127.0.0.1:5432/corbits

# API access: comma-separated owner:token pairs. Tokens must be at least 32 characters.
# Generate one with:  node -e "console.log('alice:'+require('crypto').randomBytes(32).toString('hex'))"
CORBITS_API_TOKENS=

# Language of the dashboard, history, and emails: ko (default) or en.
# CORBITS_LOCALE=ko

# Server (defaults shown). Binds to loopback only unless you change HOST.
# HOST=127.0.0.1
# PORT=8787

# Credential vault (saved passwords the browser can type, by name, after you approve). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up: without it saved credentials cannot be recovered.
CORBITS_SECRETS_KEY=

# Give a test or staging instance its own job queue so it never picks up another instance's tasks.
# CORBITS_QUEUE_SCHEMA=pgboss

# Browser sandbox. Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Set this, then run `pnpm docker:up`. If unset, Chromium runs on your machine (development only).
CORBITS_BROWSER_WS_SECRET=
# CORBITS_BROWSER_PORT=9222

# Drive your own Chrome instead of the sandbox (local use only, less protection; read README "Using your
# own Chrome"). Start it with `pnpm chrome`. Needs CORBITS_ALLOWED_ORIGINS (or CORBITS_ALLOW_ANY_ORIGIN) below. With
# CORBITS_BROWSER_WS_SECRET also set, the sandbox stays the default and admins pick "my Chrome" per task.
# CORBITS_BROWSER_CDP_URL=http://127.0.0.1:9223

# People you add in the dashboard (Users page) get these limits unless you set something else for them.
# The tokens in CORBITS_API_TOKENS are admins and have no limits.
# CORBITS_USER_MAX_CONCURRENT=2
# CORBITS_USER_DAILY_SPEND_USD=2
# CORBITS_USER_MAX_TASKS_PER_HOUR=30

# Jev (TypeSafe's decision model) makes plain "which link next" steps instead of the main model, whenever
# TYPESAFE_API_KEY is set (see README "Saving tokens"). Never used for approvals or permissions.
# TYPESAFE_API_KEY=
# CORBITS_JEV_MIN_CONFIDENCE=0.6   # default 0.6 (first) or 0.75 (assist); never below 0.6
# CORBITS_JEV_MODE=first         # first (default): Jev drives, the main model only plans, finishes and handles risky or unclear steps. assist: the main model drives, Jev picks plain links

# Scheduled tasks start themselves while this process runs. Set to 0 to turn the scheduler off.
# CORBITS_SCHEDULER=1

# Evidence files (screenshots, page text) expire so sensitive pages are not kept forever.
# CORBITS_ARTIFACT_RETENTION_DAYS=30
# CORBITS_ARTIFACT_MAX_PER_TASK=80
# CORBITS_ARTIFACT_MAX_MB_PER_TASK=40

# Browser safety. Leave private network off unless you are testing against localhost.
# CORBITS_ALLOWED_ORIGINS=https://example.com,https://docs.example.com
# Own-Chrome mode only, instead of the list above: let the agent visit ANY public site. Weaker: a page's
# injected text can then send the agent anywhere that profile is logged in. Private addresses stay blocked.
# CORBITS_ALLOW_ANY_ORIGIN=true
# CORBITS_ALLOW_PRIVATE_NETWORK=false

# Worker and limits (server-side maximums; a task may only request lower values).
# CORBITS_WORKER_CONCURRENCY=2
# CORBITS_SESSION_IDLE_MINUTES=30
# CORBITS_MAX_TOOL_CALLS=60
# CORBITS_MAX_RUNTIME_MINUTES=30
# CORBITS_MAX_SPEND_USD=2
# CORBITS_MAX_RECOVERY_ATTEMPTS=2

# Email notifications (completion, failure, approval requests). All three of USER, PASS and
# OWNER_EMAILS are required to enable them; with none set, notifications queue but are not sent.
# Free option: a Gmail account with 2-Step Verification and an app password
# (https://myaccount.google.com/apppasswords). Prefer a dedicated sender account: an app password
# grants mail access to the whole account.
# CORBITS_OWNER_EMAILS=alice:alice@example.com
# CORBITS_SMTP_USER=sender@gmail.com
# Gmail shows app passwords in four groups ("abcd efgh ijkl mnop"). Paste it without the spaces, or put it in
# quotes. (Spaces make the line unreadable to a shell, e.g. `source .env`; Corbits itself reads it either way.)
# CORBITS_SMTP_PASS=
# CORBITS_SMTP_HOST=smtp.gmail.com
# CORBITS_SMTP_PORT=465
# CORBITS_SMTP_FROM="Corbits <sender@gmail.com>"
# CORBITS_PUBLIC_URL=http://127.0.0.1:8787

# --- Production server only (see docs/deploy-oracle.md) ---
# Login for the Claude Code backend on a machine where you cannot run an interactive login.
# Create it on your own computer with `claude setup-token` (needs a Claude subscription); it is valid
# for one year and only allows model requests. Personal use only.
# CLAUDE_CODE_OAUTH_TOKEN=
# Password for the production Postgres (docker-compose.prod.yml). Any long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# POSTGRES_PASSWORD=
# CORBITS_PUBLIC_URL=https://<your-machine>.<tailnet>.ts.net
